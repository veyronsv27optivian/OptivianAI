# ═══════════════════════════════════════════════════════════════════
#  AI PROVIDER CONFIGURATION — 4 Models
# ═══════════════════════════════════════════════════════════════════
#
#  ┌──────────────┬────────────────────┬───────────────────────┐
#  │ Provider     │ Env Key            │ Default Model         │
#  ├──────────────┼────────────────────┼───────────────────────┤
#  │ Gemini  (1)  │ VITE_GEMINI_API_KEY│ gemini-2.0-flash      │
#  │ DeepSeek (2) │ VITE_OPENROUTER_KEY│ deepseek/deepseek-r1  │
#  │ Qwen VL  (3) │ VITE_OPENROUTER_KEY│ qwen/qwen2.5-vl-72b   │
#  │ OpenAI   (4) │ VITE_OPENROUTER_KEY│ openai/gpt-4o-mini    │
#  └──────────────┴────────────────────┴───────────────────────┘
#
#  IMPORTANT:
#  - Gemini is the DEFAULT provider. Set VITE_GEMINI_API_KEY first.
#  - DeepSeek, Qwen, and OpenAI all use OpenRouter. Set ONE key
#    (VITE_OPENROUTER_API_KEY) for all three, or set individual
#    VITE_DEEPSEEK_API_KEY / VITE_QWEN_API_KEY to override.
#  - All 4 providers have automatic fallback: if Gemini fails,
#    the system tries DeepSeek → Qwen → OpenAI automatically.

# ── 1. Gemini (DEFAULT) ──────────────────────────────────────────
# Get a free API key: https://aistudio.google.com/apikey
# Must start with "AIza" or "AQ." (Google AI Studio). OAuth / Firebase tokens will not work.
VITE_GEMINI_API_KEY=AIzaSyAb8RN6IQBQUZcievc7RUx5nvxe-Pc89uymw5n5iCIo9ZJ3nXCQ
VITE_GEMINI_MODEL=gemini-2.0-flash

# ── 2. OpenRouter API Key (shared by DeepSeek, Qwen & OpenAI) ───
# Get a free key: https://openrouter.ai/keys
# Free tier includes: deepseek-r1, qwen-vl, gpt-4o-mini, etc.
# Set this ONE variable and DeepSeek, Qwen, AND OpenAI all work.
VITE_OPENROUTER_API_KEY=your_openrouter_key_here

# ── 3. Provider-specific overrides (optional) ────────────────────
# If you want different models PER provider, set these individually.
# Otherwise they fall back to VITE_OPENROUTER_API_KEY above.

# DeepSeek (via OpenRouter) — Text only, no vision.
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_MODEL=deepseek/deepseek-r1:free

# Qwen VL (via OpenRouter) — Supports vision (image analysis).
VITE_QWEN_API_KEY=
VITE_QWEN_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# OpenAI (via OpenRouter) — Full GPT-4o capability.
# VITE_OPENROUTER_OPENAI_MODEL=openai/gpt-4o-mini

# ── 4. OpenRouter Metadata (optional, for analytics) ────────────
# Tells OpenRouter which app is making requests.
VITE_OPENROUTER_REFERRER=https://optivian.ai
VITE_OPENROUTER_TITLE=OptivianAI

# ── 5. CORS Proxy (for Website & YouTube Analyzers) ─────────────
# Used by the web fetcher to fetch live web content from any URL.
# The default is a free public proxy. No API key needed.
# You can replace with your own proxy or backend endpoint.
VITE_CORS_PROXY_URL=https://api.allorigins.win/raw?url=

# ── 6. Email Service (Resend or SendGrid) ────────────────────────
# To enable email notifications, set the provider and API key.
# Supported providers: resend, sendgrid
VITE_EMAIL_PROVIDER=resend
